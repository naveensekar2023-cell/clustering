      "source": [
        "Step 3: Feature Selection"
      ],
      "metadata": {
        "id": "wGWRilg-jcfD"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "X = df[['Battery_V','Battery_I','SOC (%)','SOH (%)','Solar_V','Solar_I',\n",
        "        'Engine_RPM','Alt_V','Alt_I','Motor_Speed','Motor_Torque',\n",
        "        'Throttle (%)','Brake','Ambient_Temp (°C)','Road_Grade (%)']].copy()\n",
        "\n",
        "# Convert Brake ON/OFF to numeric safely\n",
        "X.loc[:, 'Brake'] = X['Brake'].apply(lambda x: 1 if x==\"ON\" else 0)\n",
        "\n",
        "# Target labels\n",
        "y = df['Source_Mode'].map({'Solar':0,'Engine':1,'Combined':2,'AC Mains':3})\n",
        "\n",
        "print(\"Target Labels Preview:\")\n",
        "print(y.head())\n"
      ],
      "metadata": {
